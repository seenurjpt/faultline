{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faultline-processor",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // The Neon HTTP driver needs Node compatibility for its internals.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated exact origins. A browser sends Origin without a
    // trailing slash, and corsHeaders() compares the header verbatim, so
    // these must not have one either. localhost stays for local dev.
    "ALLOWED_ORIGINS": "http://localhost:3000,https://faultline-orcin.vercel.app"
  }
  // DATABASE_URL is a secret: wrangler secret put DATABASE_URL
}
